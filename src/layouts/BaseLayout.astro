---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  ogImage = "/og-default.png",
  ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon — placeholder, real asset lands during craft -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Plausible Analytics — privacy-friendly, no cookie banner needed.
      Site setup at https://plausible.io with domain tulsamann.com.
      Defer the script for performance. Gated to production to avoid
      polluting analytics during dev.
    -->
    {import.meta.env.PROD && (
      <script
        defer
        is:inline
        data-domain="tulsamann.com"
        src="https://plausible.io/js/script.js"
      />
    )}

    <slot name="head-extra" />
  </head>
  <body>
    <a href="#top" class="skip-link">Skip to content</a>
    <slot />

    <style is:global>
      /*
       * Skip link — accessibility primitive. Hidden until keyboard-focused,
       * then jumps the visitor past the nav directly to the main content.
       */
      .skip-link {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--color-clay);
        color: var(--color-canvas);
        text-decoration: none;
        font-weight: 500;
        border-radius: 0 0 6px 0;
        transform: translateY(-100%);
        transition: transform 0.15s ease;
      }
      .skip-link:focus {
        transform: translateY(0);
        outline: none;
      }
    </style>
  </body>
</html>
