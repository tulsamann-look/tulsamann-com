---
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PostMeta from "../components/writing/PostMeta.astro";
import PostFooter from "../components/writing/PostFooter.astro";
import { readingTimeFromMarkdown } from "../utils/reading-time";
import { SITE, LINKEDIN_URL } from "../config";
import type { WritingEntry } from "../utils/cluster";

interface Props {
  entry: WritingEntry;
}
const { entry } = Astro.props;
const { data, body, slug } = entry;

const readingTime = readingTimeFromMarkdown(body);
const ogImage = data.ogImage ?? `/og/${slug}.png`;
const title = `${data.title} | ${SITE.name}`;
const canonicalAbs = new URL(Astro.url.pathname, Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  image: new URL(ogImage, Astro.site).toString(),
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: {
    "@type": "Person",
    name: "Tulsa Mann",
    url: LINKEDIN_URL,
  },
  publisher: {
    "@type": "Organization",
    name: "Look Consulting",
    logo: {
      "@type": "ImageObject",
      url: new URL("/og-default.png", Astro.site).toString(),
    },
  },
  mainEntityOfPage: canonicalAbs,
};
---

<BaseLayout
  title={title}
  description={data.description}
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head-extra">
    <meta property="article:published_time" content={data.publishDate.toISOString()} />
    {data.updatedDate && (
      <meta property="article:modified_time" content={data.updatedDate.toISOString()} />
    )}
    <meta property="article:author" content={LINKEDIN_URL} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <Nav />

  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{data.title}</h1>
      <p class="post-subtitle">{data.description}</p>
      <PostMeta
        publishDate={data.publishDate}
        updatedDate={data.updatedDate}
        readingTime={readingTime}
      />
    </header>

    <div class="post-body">
      <slot />
    </div>

    <PostFooter entry={entry} />
  </article>

  <Footer />
</BaseLayout>

<style>
  .post {
    max-width: 70ch;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem 1.5rem;
  }
  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .post-title {
    font-size: clamp(2rem, 5vw, 2.625rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .post-subtitle {
    font-size: 1.125rem;
    color: var(--color-mute);
    margin: 0 0 1.5rem 0;
    line-height: 1.5;
  }
  .post-body {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .post-body :global(h2) {
    font-size: 1.75rem;
    font-weight: 600;
    margin: 3rem 0 1rem 0;
    line-height: 1.3;
  }
  .post-body :global(h3) {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem 0;
    line-height: 1.3;
  }
  .post-body :global(p) {
    margin: 0 0 1.5rem 0;
  }
  .post-body :global(a) {
    color: var(--color-clay);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease;
  }
  .post-body :global(a:hover) {
    border-bottom-color: currentColor;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-clay);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--color-mute);
    font-style: italic;
  }
  .post-body :global(code) {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.9em;
    background: var(--color-stone);
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }
  .post-body :global(pre) {
    background: var(--color-stone);
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 2rem 0;
  }
  .post-body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 2rem 0;
  }
</style>
