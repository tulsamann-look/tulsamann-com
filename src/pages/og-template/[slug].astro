---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=1200, initial-scale=1" />
    <title>OG: {data.title}</title>
    <style>
      :root {
        font-family: "Geist Variable", system-ui, sans-serif;
      }
      html, body {
        margin: 0;
        padding: 0;
        background: #f7f5ef;
      }
      .frame {
        width: 1200px;
        height: 630px;
        padding: 80px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: linear-gradient(135deg, #f7f5ef 0%, #ede9df 100%);
        position: relative;
      }
      .frame::before {
        content: "";
        position: absolute;
        top: 80px;
        left: 80px;
        width: 48px;
        height: 4px;
        background: #c25a3a;
      }
      .header {
        font-size: 22px;
        font-weight: 600;
        color: #1a1a1a;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-top: 48px;
      }
      .title {
        font-size: 64px;
        font-weight: 700;
        line-height: 1.15;
        color: #1a1a1a;
        letter-spacing: -0.02em;
        max-width: 1000px;
      }
      .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 22px;
        font-weight: 500;
        color: #6b6b66;
      }
      .by {
        font-weight: 600;
        color: #1a1a1a;
      }
    </style>
  </head>
  <body>
    <div class="frame" data-og-frame>
      <div class="header">Writing</div>
      <h1 class="title">{data.title}</h1>
      <div class="footer">
        <span class="by">Tulsa Mann</span>
        <span>tulsamann.com</span>
      </div>
    </div>
  </body>
</html>
