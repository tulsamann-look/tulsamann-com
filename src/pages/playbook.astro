---
/**
 * /playbook — render endpoint for "The B2B Lead Gen Playbook" PDF.
 *
 * Source: ../content/playbook.md (markdown, edit there).
 * Renders via PlaybookLayout. Noindex + nofollow.
 *
 * The PDF artifact is generated by `pnpm build:playbook`, which runs
 * Playwright against this URL on the dev server. Output is committed to
 * public/b2b-lead-gen-playbook.pdf and served by Vercel as a static asset.
 *
 * Tulsa can also share this URL directly as a sharable browser-readable
 * mirror of the same content.
 */
import PlaybookLayout from "../layouts/PlaybookLayout.astro";
import { Content } from "../content/playbook.md";
import { LEAD_MAGNET, SITE } from "../config";
---

<PlaybookLayout
  title={`${LEAD_MAGNET.title} — ${SITE.name}`}
  description={LEAD_MAGNET.subtitle}
>
  <Content />
</PlaybookLayout>
