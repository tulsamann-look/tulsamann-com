---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ClientWork from "../components/ClientWork.astro";
import Building from "../components/Building.astro";
import Writing from "../components/Writing.astro";
import About from "../components/About.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

import { SITE, LEAD_MAGNET } from "../config";
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={`I run Look Consulting. I build with Claude. ${LEAD_MAGNET.title} is free in your inbox.`}
>
  <Nav />
  <main>
    <Hero />
    <ClientWork />
    <Building />
    <Writing />
    <About />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
