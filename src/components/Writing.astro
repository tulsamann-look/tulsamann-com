---
/**
 * Writing section — recent thinking.
 *
 * Three latest posts. "Read more" links out to LinkedIn long-form (per
 * BRIEF.md §5 row 5 — drives LinkedIn follow + CRM signal). Section
 * bottom has the second of three email captures.
 */

import EmailForm from "./EmailForm.astro";
import { RECENT_POSTS } from "../config";
---

<section id="writing" class="section">
  <div class="container-wide">
    <header class="section-header">
      <p class="eyebrow">Writing</p>
      <h2 class="headline">What I'm writing about.</h2>
      <p class="section-lede muted">
        Long-form pieces on B2B lead generation, AI implementation, and what it actually looks
        like to run a small business on Claude. Published on LinkedIn, mirrored here.
      </p>
    </header>

    <ol class="posts">
      {RECENT_POSTS.map((post) => (
        <li class="post">
          <p class="post-date">{post.date}</p>
          <h3 class="post-title">
            <a href={post.url} target="_blank" rel="noopener noreferrer" class="post-link">
              {post.title}
            </a>
          </h3>
          <p class="post-excerpt">{post.excerpt}</p>
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="post-readmore">
            Read on LinkedIn →
          </a>
        </li>
      ))}
    </ol>

    <div class="writing-cta">
      <h3 class="writing-cta-headline">
        Get the next piece in your inbox.
      </h3>
      <p class="writing-cta-sub muted">
        Plus <strong>The B2B Lead Gen Playbook</strong> as a welcome.
      </p>
      <div class="writing-cta-form">
        <EmailForm size="md" source="writing" cta="Send it" hideMagnetCopy={true} />
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    max-width: 60ch;
    margin-bottom: 3rem;
  }

  .section-header .headline {
    margin-top: 0.75rem;
  }

  .section-lede {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .post {
    padding-block: 2rem;
    border-top: 1px solid var(--color-hairline);
  }

  .post:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem 0;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.015em;
    max-width: 56ch;
  }

  .post-link {
    color: var(--color-ink);
    text-decoration: none;
  }

  .post-link:hover {
    color: var(--color-clay-deep);
    text-decoration: none;
  }

  .post-excerpt {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0 0 1rem 0;
    max-width: 56ch;
  }

  .post-readmore {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-clay);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .post-readmore:hover {
    color: var(--color-clay-deep);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .writing-cta {
    margin-top: 4rem;
    padding: 2.5rem;
    background: var(--color-stone);
    border-radius: 8px;
    max-width: 640px;
  }

  .writing-cta-headline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .writing-cta-sub {
    margin-top: 0.5rem;
    font-size: var(--text-base);
  }

  .writing-cta-sub strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .writing-cta-form {
    margin-top: 1.5rem;
  }
</style>
