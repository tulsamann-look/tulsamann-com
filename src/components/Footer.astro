---
/**
 * Footer — minimal. Copyright, last-updated, social, colophon.
 *
 * No email capture (we have three above). The colophon is a small Cohort B
 * easter egg — geek signal without being precious.
 */

import { LINKEDIN_URL, TWITTER_URL, GITHUB_URL, CONTACT_EMAIL } from "../config";

const lastUpdated = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-wide footer-inner">
    <p class="footer-meta">
      <span>© {year} Tulsa Mann.</span>
      <span class="footer-sep">·</span>
      <span>Last updated {lastUpdated}.</span>
    </p>

    <ul class="footer-links">
      <li>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="link-plain">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={TWITTER_URL} target="_blank" rel="noopener noreferrer" class="link-plain">
          X
        </a>
      </li>
      <li>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="link-plain">
          GitHub
        </a>
      </li>
      <li>
        <a href={`mailto:${CONTACT_EMAIL}`} class="link-plain">
          Email
        </a>
      </li>
    </ul>

    <p class="footer-colophon muted">
      Built with Astro + Tailwind. Designed with
      <a
        href="https://github.com/pbakaus/impeccable"
        target="_blank"
        rel="noopener noreferrer"
      >
        impeccable
      </a>. Deployed on Vercel.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-hairline);
    padding-block: 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-mute);
    margin: 0;
  }

  .footer-sep {
    opacity: 0.5;
  }

  .footer-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.25rem;
  }

  .footer-links li {
    list-style: none;
  }

  .footer-links .link-plain {
    font-size: var(--text-sm);
  }

  .footer-colophon {
    flex-basis: 100%;
    font-size: var(--text-xs);
    margin: 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-hairline);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-links {
      flex-wrap: wrap;
    }
  }
</style>
