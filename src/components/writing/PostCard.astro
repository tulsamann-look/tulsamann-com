---
import { readingTimeFromMarkdown } from "../../utils/reading-time";
import type { WritingEntry } from "../../utils/cluster";

interface Props {
  post: WritingEntry;
  variant?: "default" | "featured";
}
const { post, variant = "default" } = Astro.props;
const readingTime = readingTimeFromMarkdown(post.body);
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<a href={`/writing/${post.slug}`} class={`post-card ${variant}`}>
  {variant === "featured" && <span class="badge">Cornerstone</span>}
  <h2 class="title">{post.data.title}</h2>
  <p class="description">{post.data.description}</p>
  <div class="meta">
    <time datetime={post.data.publishDate.toISOString()}>
      {formatDate(post.data.publishDate)}
    </time>
    <span class="dot">·</span>
    <span>{readingTime} min read</span>
  </div>
</a>

<style>
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem;
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .post-card:hover {
    border-color: var(--color-clay);
    transform: translateY(-1px);
  }
  .post-card.featured {
    padding: 2rem;
    border-width: 2px;
    background: var(--color-stone);
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-clay);
    margin-bottom: 0.75rem;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .featured .title {
    font-size: 1.75rem;
  }
  .description {
    font-size: 0.95rem;
    color: var(--color-mute);
    margin: 0 0 1rem 0;
    line-height: 1.5;
  }
  .featured .description {
    font-size: 1.05rem;
  }
  .meta {
    font-size: 0.85rem;
    color: var(--color-mute);
  }
  .meta .dot {
    opacity: 0.5;
    margin: 0 0.5rem;
  }
</style>
