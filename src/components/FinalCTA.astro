---
/**
 * Final CTA — three doors.
 *
 * Per BRIEF.md §5 row 7 (rev 2): three equal-weight options:
 *   1. Subscribe (third email capture, smallest)
 *   2. Follow on LinkedIn
 *   3. Email me (mailto)
 *
 * No "Book a call" — relationship starts via email or LinkedIn.
 */

import EmailForm from "./EmailForm.astro";
import { LINKEDIN_URL, CONTACT_EMAIL } from "../config";
---

<section id="cta" class="section surface-stone">
  <div class="container-wide">
    <header class="section-header">
      <p class="eyebrow">Keep going</p>
      <h2 class="headline">Three ways to stay in touch.</h2>
      <p class="section-lede muted">
        No funnel. Just three durable channels. Pick the one that fits how you read the
        internet.
      </p>
    </header>

    <div class="doors-grid">
      <article class="door">
        <p class="door-num">01</p>
        <h3 class="door-title">Subscribe to the list</h3>
        <p class="door-body">
          One email per piece of writing. Get <strong>The B2B Lead Gen Playbook</strong> as a
          welcome.
        </p>
        <div class="door-action">
          <EmailForm size="sm" source="final-cta" cta="Subscribe" hideMagnetCopy={true} />
        </div>
      </article>

      <article class="door">
        <p class="door-num">02</p>
        <h3 class="door-title">Follow on LinkedIn</h3>
        <p class="door-body">
          The long-form thinking lives there. Reply, DM, comment — I read everything.
        </p>
        <div class="door-action">
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost door-btn"
          >
            Follow on LinkedIn →
          </a>
        </div>
      </article>

      <article class="door">
        <p class="door-num">03</p>
        <h3 class="door-title">Email me directly</h3>
        <p class="door-body">
          Goes to my inbox. I usually reply within a day. Best for high-intent questions about
          your lead gen.
        </p>
        <div class="door-action">
          <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-ghost door-btn">
            Send me an email →
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .section-header {
    max-width: 56ch;
    margin-bottom: 3rem;
  }

  .section-header .headline {
    margin-top: 0.75rem;
  }

  .section-lede {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .doors-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
  }

  .door-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-clay);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .door-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .door-body {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
    flex: 1;
  }

  .door-body strong {
    font-weight: 500;
  }

  .door-action {
    margin-top: 0.5rem;
  }

  .door-btn {
    width: 100%;
  }

  @media (max-width: 880px) {
    .doors-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
